function [Kx_3, Ky_3, Kz_3] = generate_rosette_trajectory(matrix_size, fov)
%GENERATE_ROSETTE_TRAJECTORY
% Generates a 3D rosette k-space trajectory (kx, ky, kz) scaled to ±pi.
%
% INPUTS:
%   matrix_size : number of samples along one spatial dimension
%   fov         : field of view (in meters)
%
% OUTPUTS:
%   Kx_3, Ky_3, Kz_3 : column vectors of normalized k-space coordinates

    % Calculate kmax
    kmax = matrix_size / fov / 2;

    % Startup/wind-down weighting
    weighted = [0.05,0.10,0.15,0.20,0.25,0.30,0.35,0.40,0.45,0.50,...
                0.50,0.55,0.60,0.65,0.70,0.75,0.80,0.85,0.90,0.95];
    weighted_cum = cumsum(weighted);

    % Initialize k-space arrays
    kx = zeros(190,378,109);
    ky = zeros(190,378,109);
    kz = zeros(190,378,109);

    % Build trajectory
    for ll = 1:190
        alpha = pi/189 * (ll - 1);

        for kk = 1:378
            phi = 2*pi/378 * (kk - 1);

            % Startup region
            for jj = 1:20
                w = weighted_cum(jj);
                ang = pi/195 * w;
                kx(ll,kk,jj+2) = kmax*sin(ang)*cos(ang+phi)*cos(-pi/2+alpha);
                ky(ll,kk,jj+2) = kmax*sin(ang)*sin(ang+phi)*cos(-pi/2+alpha);
                kz(ll,kk,jj+2) = kmax*sin(ang)*sin(-pi/2+alpha);
            end

            % Main region
            for ii = 11:184
                ang = pi/195 * ii;
                kx(ll,kk,ii+11+1) = kmax*sin(ang)*cos(ang+phi)*cos(-pi/2+alpha);
                ky(ll,kk,ii+11+1) = kmax*sin(ang)*sin(ang+phi)*cos(-pi/2+alpha);
                kz(ll,kk,ii+11+1) = kmax*sin(ang)*sin(-pi/2+alpha);
            end

            % Wind-down region
            for jj = 1:20
                w = 195 - weighted_cum(21 - jj);
                ang = pi/195 * w;
                kx(ll,kk,jj+195+1) = kmax*sin(ang)*cos(ang+phi)*cos(-pi/2+alpha);
                ky(ll,kk,jj+195+1) = kmax*sin(ang)*sin(ang+phi)*cos(-pi/2+alpha);
                kz(ll,kk,jj+195+1) = kmax*sin(ang)*sin(-pi/2+alpha);
            end
        end
    end

    % Reorder dimensions
    kx = permute(kx,[3 2 1]);
    ky = permute(ky,[3 2 1]);
    kz = permute(kz,[3 2 1]);

    % Interleave/average to 432x378x190
    Kx_new = zeros(432,378,190);
    Ky_new = zeros(432,378,190);
    Kz_new = zeros(432,378,190);

    for ii = 1:431
        if rem(ii,2)==1
            idx = fix(ii/2)+1;
            Kx_new(ii,:,:) = kx(idx,:,:);
            Ky_new(ii,:,:) = ky(idx,:,:);
            Kz_new(ii,:,:) = kz(idx,:,:);
        else
            idx = fix(ii/2);
            Kx_new(ii,:,:) = (kx(idx,:,:)+kx(idx+1,:,:))/2;
            Ky_new(ii,:,:) = (ky(idx,:,:)+ky(idx+1,:,:))/2;
            Kz_new(ii,:,:) = (kz(idx,:,:)+kz(idx+1,:,:))/2;
        end
    end

    Kx_new(432,:,:) = kx(216,:,:);
    Ky_new(432,:,:) = ky(216,:,:);
    Kz_new(432,:,:) = kz(216,:,:);

    % --- Select subset and flatten ---
    Kx_2 = Kx_new(2:217,:,:);
    Ky_2 = Ky_new(2:217,:,:);
    Kz_2 = Kz_new(2:217,:,:);

    Kx_2 = Kx_2(:);
    Ky_2 = Ky_2(:);
    Kz_2 = Kz_2(:);

    % Normalize to max = pi
    Kx_3 = pi / max(abs(Kx_2)) * Kx_2;
    Ky_3 = pi / max(abs(Ky_2)) * Ky_2;
    Kz_3 = pi / max(abs(Kz_2)) * Kz_2;
end
